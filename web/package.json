{
  "name": "live-recognition-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "build:pages": "npm run build -- --base=/auto-stew/ --outDir=../docs --emptyOutDir",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --host 127.0.0.1 --base=/auto-stew/ --outDir=../docs",
    "test": "tsx --test src/lib/*.test.ts",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "predev": "npm run sync:runtime",
    "prebuild": "npm run sync:runtime"
  },
  "dependencies": {
    "cubing": "^0.66.1",
    "mediabunny": "^1.66.0",
    "onnxruntime-web": "1.23.2",
    "svelte": "^5.43.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^22.19.0",
    "@webgpu/types": "^0.1.74",
    "svelte-check": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
